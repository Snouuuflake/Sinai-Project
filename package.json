{
  "name": "sinai-project",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "icon": "./icon.png",
  "author": "Snouuuflake",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:display dev:electron dev:mobile-ui",
    "dev:react": "vite --config vite.config.ui.ts",
    "dev:display": "vite --config vite.config.display.ts",
    "dev:mobile-ui": "vite --config vite.config.mobile-ui.ts",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "npm run build:ui && npm run build:display && npm run build:mobile-ui && npm run transpile:electron",
    "build:ui": "vite build --config vite.config.ui.ts",
    "build:display": "vite build --config vite.config.display.ts",
    "build:mobile-ui": "vite build --config vite.config.mobile-ui.ts",
    "bdev": "npm run build:display && npm run dev",
    "transpile:electron": "tsc --project src/electron/tsconfig.json && esbuild src/electron/preload-display.cts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload-display.cjs",
    "rmdist": "powershell -Command \"if (Test-Path dist) {Remove-Item -Recurse -Force dist}\"",
    "dist:win": "npm run rmdist && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "express": "^5.2.1",
    "fast-fuzzy": "^1.12.0",
    "lucide-react": "^0.561.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1"
  }
}
